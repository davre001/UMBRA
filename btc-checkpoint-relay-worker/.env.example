# Base URL of the running backend (btc-deposit routes) to poll and submit
# proofs to.
BACKEND_URL=http://localhost:4000

# Must match the backend's BTC_DEPOSIT_INTERNAL_SECRET — see backend/.env.example.
BTC_DEPOSIT_INTERNAL_SECRET=

# Milliseconds between poll cycles. Signet produces a block roughly every
# 10 minutes, so there's no point checking faster than that — default paces
# real block production rather than hammering the signet API on a fixed
# short interval the way btc-deposit-worker's does (that one has no
# batching reason to wait; this one has a real one).
POLL_INTERVAL_MS=600000

# Optional override for the signet API source (mempool.space by default,
# see src/headers.ts) — set this to point at a mirror if the default is
# unreachable from your network.
MEMPOOL_SIGNET_API_BASE=
