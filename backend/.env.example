PORT=4000

# Coston2-funded key shared by every on-chain-touching backend service
# (compliance attester, relayer, dark-engine matcher) — see chain.ts for why
# that's a testnet-only shortcut, not a production trust model.
PRIVATE_KEY=

# Optional blocklist for the placeholder compliance ruleset (see
# compliance/fdc.client.ts) — comma-separated addresses.
COMPLIANCE_BLOCKLIST=

# Shared secret gating GET /api/dark-engine/matches/:id/proof-inputs, which
# exposes private order details to a real match-proving worker (see
# matcher-worker/) — unset disables the endpoint entirely.
MATCHER_INTERNAL_SECRET=

# Turso (hosted libSQL) connection for the dark-engine matcher's durable
# store (dark-engine/store.ts) — persists the order book and match records
# so they survive a restart (this service has no persistent disk on Render's
# free plan). Optional: unset falls back to in-memory-only, same as before
# this existed — fine for local dev, not for a real deployment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
