PORT=4000

# Comma-separated origins allowed to call this API (see app.ts's cors()
# setup). Optional: unset falls back to the deployed frontend
# (https://umbra-flare.vercel.app) plus localhost:3000 for local dev.
FRONTEND_ORIGINS=

# Coston2-funded key shared by every on-chain-touching backend service
# (compliance attester, relayer, dark-engine matcher) — see chain.ts for why
# that's a testnet-only shortcut, not a production trust model.
PRIVATE_KEY=

# Optional blocklist for the placeholder compliance ruleset (see
# compliance/fdc.client.ts) — comma-separated addresses.
COMPLIANCE_BLOCKLIST=

# Shared secret gating GET /api/dark-engine/matches/:id/proof-inputs, which
# exposes private order details to a real match-proving worker (see
# matcher-worker/) — unset disables the endpoint entirely.
MATCHER_INTERNAL_SECRET=

# Turso (hosted libSQL) connection, shared by every durable store in this
# backend — dark-engine's order book/match records (dark-engine/store.ts)
# AND btc-withdrawal's fulfillment records (btc-withdrawal/store.ts) — so
# they survive a restart (this service has no persistent disk on Render's
# free plan). Optional: unset falls back to in-memory-only for both, same
# as before either existed — fine for local dev, not for a real deployment,
# and a real fund-safety gap specifically for btc-withdrawal (see
# BTC_DEPOSIT_DESIGN.md's "Withdrawal" section).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared secret gating the btc-deposit module's worker-only routes
# (GET /api/btc-deposit/:id/proof-inputs, POST /:id/proof, /:id/fail,
# POST /checkpoint) — must match btc-deposit-worker/.env's own copy.
# Unset disables those endpoints entirely (see btc-deposit.routes.ts).
BTC_DEPOSIT_INTERNAL_SECRET=

# Real deployed signet P2WPKH vault pubkey hash (20 bytes, hex, no 0x) that
# btc-deposit deposits must pay — must match contract/circuits/noir/
# btc_deposit/src/bitcoin.nr's VAULT_PUBKEY_HASH exactly. Optional: unset
# falls back to the same all-zero placeholder the circuit currently uses
# (fine for testing against the circuit's own synthetic fixtures, NOT a
# real address — see BTC_DEPOSIT_DESIGN.md).
BTC_VAULT_PUBKEY_HASH=

# Signet block height this backend assumes is currently registered as
# ShieldedVault's BTC checkpoint (see btc-deposit/checkpoint.ts's own doc
# for why this can't be inferred from chain state). Optional: unset until
# scripts/refresh-btc-checkpoint.ts (or a manual POST /api/btc-deposit/checkpoint
# call) sets one.
BTC_CHECKPOINT_HEIGHT=

# The BTC custodian's real signet private key (Wallet Import Format) —
# THIS IS THE ONE REAL FUND-CUSTODY SECRET IN THIS ENTIRE REPO. Its P2WPKH
# address must be the SAME address BTC_VAULT_PUBKEY_HASH above and the
# deposit circuit's own VAULT_PUBKEY_HASH point to — deposits pay into it,
# withdrawals pay out of it. Optional: unset disables the withdrawal
# fulfillment loop entirely (see index.ts's startBtcWithdrawalWatcher) —
# most deployments, including local dev, should leave this unset. Never
# commit a real value; never reuse a key from anywhere else.
BTC_CUSTODIAN_WIF=

# Milliseconds between BTC withdrawal fulfillment poll cycles. No batching
# reason to wait, but Bitcoin blocks land roughly every 10 minutes even on
# signet, so a very short interval buys little — default is deliberately
# slower than the deposit worker's own poll.
BTC_WITHDRAWAL_POLL_INTERVAL_MS=30000

# Milliseconds between deposit self-registration poll cycles (see
# btc-deposit/depositWatcher.ts) — independently scans the vault's own
# deposit address and registers any deposit whose depositor never
# completed their own POST /submit call (e.g. closed the tab mid-flight).
# Runs whenever BTC_VAULT_PUBKEY_HASH above is set, independent of
# BTC_CUSTODIAN_WIF — it only ever reads chain data, never signs anything.
BTC_DEPOSIT_WATCH_POLL_INTERVAL_MS=30000
