PORT=4000

# Comma-separated origins allowed to call this API (see app.ts's cors()
# setup). Optional: unset falls back to the deployed frontend
# (https://umbra-flare.vercel.app) plus localhost:3000 for local dev.
FRONTEND_ORIGINS=

# Coston2-funded key shared by every on-chain-touching backend service
# (compliance attester, relayer, dark-engine matcher) — see chain.ts for why
# that's a testnet-only shortcut, not a production trust model.
PRIVATE_KEY=

# Optional blocklist for the placeholder compliance ruleset (see
# compliance/fdc.client.ts) — comma-separated addresses.
COMPLIANCE_BLOCKLIST=

# Shared secret gating GET /api/dark-engine/matches/:id/proof-inputs, which
# exposes private order details to a real match-proving worker (see
# matcher-worker/) — unset disables the endpoint entirely.
MATCHER_INTERNAL_SECRET=

# Turso (hosted libSQL) connection, shared by every durable store in this
# backend — dark-engine's order book/match records (dark-engine/store.ts)
# AND btc-withdrawal's fulfillment records (btc-withdrawal/store.ts) — so
# they survive a restart (this service has no persistent disk on Render's
# free plan). Optional: unset falls back to in-memory-only for both, same
# as before either existed — fine for local dev, not for a real deployment,
# and a real fund-safety gap specifically for btc-withdrawal (see
# BTC_DEPOSIT_DESIGN.md's "Withdrawal" section).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared secret gating the btc-deposit module's worker-only routes
# (GET /api/btc-deposit/:id/proof-inputs, POST /:id/proof, /:id/fail,
# POST /checkpoint) — must match btc-deposit-worker/.env's own copy.
# Unset disables those endpoints entirely (see btc-deposit.routes.ts).
BTC_DEPOSIT_INTERNAL_SECRET=

# Gates btc-withdrawal.routes.ts's PSBT sign/collect routes — a different
# secret than BTC_DEPOSIT_INTERNAL_SECRET on purpose: distribute this one
# to the 2-of-3 reserve signers specifically (see
# scripts/sign-btc-withdrawal.ts), a different trust boundary than the
# deposit-proving worker's own secret. Unset disables those routes.
BTC_WITHDRAWAL_INTERNAL_SECRET=

# Real deployed signet P2WPKH vault pubkey hash (20 bytes, hex, no 0x) that
# btc-deposit deposits must pay — must match contract/circuits/noir/
# btc_deposit/src/bitcoin.nr's VAULT_PUBKEY_HASH exactly. Optional: unset
# falls back to the same all-zero placeholder the circuit currently uses
# (fine for testing against the circuit's own synthetic fixtures, NOT a
# real address — see BTC_DEPOSIT_DESIGN.md).
BTC_VAULT_PUBKEY_HASH=

# Signet block height this backend assumes is currently registered as
# ShieldedVault's BTC checkpoint (see btc-deposit/checkpoint.ts's own doc
# for why this can't be inferred from chain state). Optional: unset until
# contract/scripts/initialize-btc-checkpoint.ts's genesis bootstrap (or a
# manual POST /api/btc-deposit/checkpoint call) sets one — after that,
# btc-checkpoint-relay-worker keeps it in sync automatically.
BTC_CHECKPOINT_HEIGHT=

# The BTC custodian's real signet private key (Wallet Import Format) —
# THIS IS THE ONE REAL FUND-CUSTODY SECRET IN THIS ENTIRE REPO. Its P2WPKH
# address must be the SAME address BTC_VAULT_PUBKEY_HASH above and the
# deposit circuit's own VAULT_PUBKEY_HASH point to — deposits pay into it,
# withdrawals pay out of it. Optional: unset disables the withdrawal
# fulfillment loop entirely (see index.ts's startBtcWithdrawalWatcher) —
# most deployments, including local dev, should leave this unset. Never
# commit a real value; never reuse a key from anywhere else.
BTC_CUSTODIAN_WIF=

# The 2-of-3 BTC reserve's three signer public keys (33-byte compressed,
# 66 hex chars each) — see btc-withdrawal/reserve.ts. This backend derives
# the reserve's real P2WSH address from these and funds withdrawals from
# it instead of BTC_CUSTODIAN_WIF directly (sweep.ts moves confirmed hot-
# wallet funds there automatically). Deliberately PUBLIC keys only — this
# process never holds a reserve private key, so leaking this backend's own
# env can't drain the reserve on its own. All three required together, or
# no reserve address can be derived at all.
BTC_RESERVE_PUBKEY_1=
BTC_RESERVE_PUBKEY_2=
BTC_RESERVE_PUBKEY_3=

# Milliseconds between sweep poll cycles — moves the hot wallet's entire
# confirmed balance into the reserve each pass, bounding BTC_CUSTODIAN_WIF's
# real exposure window to "since the last sweep" instead of "everything,
# forever." Optional: unset disables the sweep loop (same convention as
# BTC_CUSTODIAN_WIF itself — see index.ts's startBtcSweepLoop).
BTC_SWEEP_POLL_INTERVAL_MS=1800000

# Milliseconds between BTC withdrawal fulfillment poll cycles. No batching
# reason to wait, but Bitcoin blocks land roughly every 10 minutes even on
# signet, so a very short interval buys little — default is deliberately
# slower than the deposit worker's own poll.
BTC_WITHDRAWAL_POLL_INTERVAL_MS=30000

# Optional payout rate caps (see btc-withdrawal/rate-limit.ts) — bounds how
# many sats the custodian key can pay out in a trailing 1h/24h window,
# independent of each other (set either, both, or neither). A withdrawal
# that would push a window over its cap stays `pending` and is retried on
# a later poll once the window frees up; a single withdrawal larger than a
# cap fails immediately (no amount of waiting fits it). Closes (bounds, not
# eliminates) the "leaked BTC_CUSTODIAN_WIF drains everything in one shot"
# risk — see that key's own NatSpec in wallet.ts. Unset (the default) means
# uncapped, same as today.
BTC_WITHDRAWAL_MAX_SATS_PER_HOUR=
BTC_WITHDRAWAL_MAX_SATS_PER_DAY=

# Milliseconds a withdrawal can sit `pending`/`awaiting_signatures` before
# overdue.ts (and GET /api/btc-withdrawal/solvency's overdueCount/
# oldestOverdueMs fields) flags it — the observable signal for "the
# custodian key holder or reserve signers may have gone dark," see
# docs/RUNBOOK_BTC_WITHDRAWAL.md for the triage steps once this fires.
# Optional: unset falls back to 6 hours (21600000ms).
BTC_WITHDRAWAL_OVERDUE_MS=

# Milliseconds between deposit self-registration poll cycles (see
# btc-deposit/depositWatcher.ts) — independently scans the vault's own
# deposit address and registers any deposit whose depositor never
# completed their own POST /submit call (e.g. closed the tab mid-flight).
# Runs whenever BTC_VAULT_PUBKEY_HASH above is set, independent of
# BTC_CUSTODIAN_WIF — it only ever reads chain data, never signs anything.
BTC_DEPOSIT_WATCH_POLL_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# scripts/sign-btc-withdrawal.ts — a RESERVE SIGNER's own vars, NOT this
# backend's own config. Documented here only because the script lives in
# this package (so `dotenv/config` reads whatever .env sits in this
# directory by default) — do NOT put a real BTC_RESERVE_SIGNER_WIF in the
# same .env this backend server itself deploys with. Each of the 3 signers
# should run this script from their own machine with their OWN minimal
# .env containing just these 3 vars (BACKEND_URL + BTC_WITHDRAWAL_INTERNAL_SECRET
# from above + this one) — never all 3 signers' keys collected in one
# place, which would defeat the entire point of a 2-of-3 reserve (see
# reserve.ts's own doc). BTC_RESERVE_SIGNER_1/2/3_WIF sitting together in
# this backend's own local .env is fine ONLY for this repo's own
# single-machine dev/testing convenience — never do that for a real
# deployment's signer keys.
BACKEND_URL=http://localhost:4000
BTC_RESERVE_SIGNER_WIF=
BTC_WITHDRAWAL_NULLIFIER_HASH=
