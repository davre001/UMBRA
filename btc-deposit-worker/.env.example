# Base URL of the running backend (btc-deposit routes) to poll.
BACKEND_URL=http://localhost:4000

# Must match the backend's BTC_DEPOSIT_INTERNAL_SECRET — see backend/.env.example.
BTC_DEPOSIT_INTERNAL_SECRET=

# Milliseconds between poll cycles. No batching reason to wait on this flow
# (unlike match_orders) — a short interval is fine.
POLL_INTERVAL_MS=3000
