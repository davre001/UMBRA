#[test]
fn test_checkpoint_commitment_is_deterministic() {
    assert(checkpoint_commitment(real_checkpoint_hash()) == checkpoint_commitment(real_checkpoint_hash()));
}

#[test]
fn test_verify_header_chain_accepts_real_six_block_signet_run() {
    let _tip = verify_header_chain(real_checkpoint_hash(), real_signet_chain());
}

#[test(should_fail)]
fn test_verify_header_chain_rejects_tampered_mid_chain_prev_hash() {
    let mut headers = real_signet_chain();
    headers[3][4] = headers[3][4] ^ 0x01;
    let _tip = verify_header_chain(real_checkpoint_hash(), headers);
}

// --- main() wiring, real signet data ------------------------------------

#[test]
fn test_main_accepts_real_six_block_signet_checkpoint_extension() {
    let old_hash = real_checkpoint_hash();
    let old_commitment = checkpoint_commitment(old_hash);
    let headers = real_signet_chain();
    let tip_hash = verify_header_chain(old_hash, headers);
    let new_commitment = checkpoint_commitment(tip_hash);

    main(old_commitment, new_commitment, old_hash, headers);
}

#[test(should_fail)]
fn test_main_rejects_old_checkpoint_hash_not_matching_commitment() {
    // A wrong old_checkpoint_commitment_pub — confirms main() enforces that
    // binding, not just that a correct hash/commitment pair happens to pass.
    let old_hash = real_checkpoint_hash();
    let wrong_old_commitment = checkpoint_commitment(old_hash) + 1;
    let headers = real_signet_chain();
    let tip_hash = verify_header_chain(old_hash, headers);
    let new_commitment = checkpoint_commitment(tip_hash);

    main(wrong_old_commitment, new_commitment, old_hash, headers);
}

#[test(should_fail)]
fn test_main_rejects_new_commitment_not_matching_real_tip() {
    // The publicly-claimed new checkpoint doesn't match what the real header
    // chain actually tips out to — confirms main() recomputes and checks it
    // rather than trusting whatever the caller labels it (the same
    // front-running-style gap btc_deposit's own recipient/amount checks
    // guard against, applied here to which checkpoint gets accepted).
    let old_hash = real_checkpoint_hash();
    let old_commitment = checkpoint_commitment(old_hash);
    let headers = real_signet_chain();
    let tip_hash = verify_header_chain(old_hash, headers);
    let wrong_new_commitment = checkpoint_commitment(tip_hash) + 1;

    main(old_commitment, wrong_new_commitment, old_hash, headers);
}
