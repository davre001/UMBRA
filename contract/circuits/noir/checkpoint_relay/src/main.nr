mod bitcoin_headers;

use bitcoin_headers::{checkpoint_commitment, verify_header_chain, HEADER_SIZE, K};

// Proves `new_checkpoint_commitment_pub` is the Poseidon2 checkpoint
// commitment of a real chain tip reached by extending
// `old_checkpoint_commitment_pub`'s own checkpoint hash with K validly-mined,
// correctly-linked Bitcoin headers. This is the entire statement
// ShieldedVault.extendCheckpoint checks before permissionlessly advancing
// checkpoints[sourceChainId] — see that function's own NatSpec and
// circuits/BTC_DEPOSIT_DESIGN.md.
//
// old_checkpoint_hash is a PRIVATE witness, same reasoning as btc_deposit's
// own checkpoint_hash (see bitcoin_headers::checkpoint_commitment's doc for
// why a raw pub [u8; 32] doesn't collapse to one Solidity bytes32): whoever
// submits this proof must already know the raw hash behind the checkpoint's
// current on-chain commitment — it was never secret, just never stored
// on-chain in raw form.
fn main(
    old_checkpoint_commitment_pub: pub Field,
    new_checkpoint_commitment_pub: pub Field,
    old_checkpoint_hash: [u8; 32],
    headers: [[u8; HEADER_SIZE]; K],
) {
    assert(checkpoint_commitment(old_checkpoint_hash) == old_checkpoint_commitment_pub);
    let tip_hash = verify_header_chain(old_checkpoint_hash, headers);
    assert(checkpoint_commitment(tip_hash) == new_checkpoint_commitment_pub);
}

// --- Fixtures -----------------------------------------------------------
//
// Real signet header, height 317028, fetched from
// https://mempool.space/signet/api/block/{hash}/header on 2026-08-10 — same
// fixture as btc_deposit/src/main.nr's own real_signet_header(), copied here
// as data (not code) so this circuit's own primitives get the same
// real-data test coverage independently, without depending on btc_deposit's
// package (see bitcoin_headers.nr's own doc for why these are duplicated,
// not shared).
fn real_signet_header() -> [u8; bitcoin_headers::HEADER_SIZE] {
    [
        0x00, 0x00, 0x00, 0x20, 0x63, 0xcc, 0xe8, 0xe0, 0xf9, 0x42, 0xde, 0x8e,
        0xa7, 0x34, 0x5c, 0x95, 0xb8, 0xda, 0x2e, 0x5d, 0xa0, 0x55, 0x42, 0xa5,
        0xc2, 0x8a, 0xee, 0xc9, 0xa1, 0x2f, 0x35, 0x7b, 0x05, 0x00, 0x00, 0x00,
        0xe3, 0x5b, 0x9c, 0x9d, 0x08, 0x61, 0xc2, 0x69, 0xbe, 0xa5, 0x4d, 0xf9,
        0xa9, 0xb9, 0x37, 0x64, 0xaf, 0x86, 0x65, 0xe4, 0xbe, 0x13, 0xf1, 0xfc,
        0xdf, 0x72, 0x2f, 0x47, 0x5e, 0x01, 0x93, 0x15, 0x7e, 0x4d, 0x79, 0x6a,
        0x9f, 0x6a, 0x14, 0x1d, 0xba, 0x7c, 0x9f, 0x04,
    ]
}

#[test]
fn test_double_sha256_matches_real_signet_header() {
    let expected_hash: [u8; 32] = [
        0x83, 0x4e, 0x74, 0x7c, 0x24, 0x50, 0x70, 0xe4, 0xc9, 0x2c, 0xe1, 0xbe,
        0xa4, 0x08, 0xcb, 0x45, 0xa0, 0x0b, 0x95, 0x6a, 0x9d, 0x00, 0x91, 0x3b,
        0x4e, 0x03, 0xf8, 0xfd, 0x07, 0x00, 0x00, 0x00,
    ];
    assert(bitcoin_headers::double_sha256(real_signet_header()) == expected_hash);
}

#[test]
fn test_verify_pow_accepts_real_signet_header() {
    let _hash = bitcoin_headers::verify_pow(real_signet_header());
}

#[test(should_fail)]
fn test_verify_pow_rejects_header_tampered_to_claim_impossible_target() {
    let mut header = real_signet_header();
    header[72] = 1;
    header[73] = 0;
    header[74] = 0;
    header[75] = 3;
    let _hash = bitcoin_headers::verify_pow(header);
}

#[test]
fn test_parse_prev_hash_matches_real_header() {
    let expected_prev_hash: [u8; 32] = [
        0x63, 0xcc, 0xe8, 0xe0, 0xf9, 0x42, 0xde, 0x8e, 0xa7, 0x34, 0x5c, 0x95,
        0xb8, 0xda, 0x2e, 0x5d, 0xa0, 0x55, 0x42, 0xa5, 0xc2, 0x8a, 0xee, 0xc9,
        0xa1, 0x2f, 0x35, 0x7b, 0x05, 0x00, 0x00, 0x00,
    ];
    assert(bitcoin_headers::parse_prev_hash(real_signet_header()) == expected_prev_hash);
}

// checkpoint_hash == real_signet_header()'s (height 317028) own hash, and
