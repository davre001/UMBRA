// real_signet_chain, fetched from mempool.space on 2026-08-10, prev_hash
// linkage and sha256d hashes cross-checked independently with Python's
// hashlib against the API's own returned block hashes before trusting it.
fn real_checkpoint_hash() -> [u8; 32] {
    [
        0x83, 0x4e, 0x74, 0x7c, 0x24, 0x50, 0x70, 0xe4, 0xc9, 0x2c, 0xe1, 0xbe,
        0xa4, 0x08, 0xcb, 0x45, 0xa0, 0x0b, 0x95, 0x6a, 0x9d, 0x00, 0x91, 0x3b,
        0x4e, 0x03, 0xf8, 0xfd, 0x07, 0x00, 0x00, 0x00,
    ]
}

