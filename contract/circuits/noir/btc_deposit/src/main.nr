#[test]
fn test_checkpoint_commitment_is_deterministic() {
    assert(bitcoin::checkpoint_commitment(real_checkpoint_hash()) == bitcoin::checkpoint_commitment(real_checkpoint_hash()));
}

// These two test bitcoin::verify_header_chain directly (not through
// main()) against the real 6-block chain: main() now also requires a
// deposit tx included under the chain tip's real merkle_root, and no real
// transaction anywhere matches btc_deposit's brand-new template (see
// parse_deposit_tx's own fixture-provenance note) — so a real-header-chain
// test and a real-vs-synthetic-tx test can't both run through main() at
// once. main()'s own full wiring is covered by
// test_main_accepts_fully_synthetic_end_to_end_deposit below, using a
// synthetic chain built specifically so its tip's merkle_root matches a
// synthetic tx — real header-chain validity (this real 6-block run) and
// real Merkle-path validity (test_verify_tx_inclusion_matches_real_signet_tx
// above) are each independently real-data-tested regardless.
#[test]
fn test_verify_header_chain_accepts_real_six_block_signet_run() {
    let _tip = verify_header_chain(real_checkpoint_hash(), real_signet_chain());
}

#[test(should_fail)]
fn test_verify_header_chain_rejects_tampered_mid_chain_prev_hash() {
    // Same real, validly-linked 6-block chain — but with headers[3]'s
    // (height 317032) prev_hash field (offset 4..36) flipped by one byte.
    // Neither the tampered header's own hash nor headers[4]'s prev_hash
    // reference change, so this only breaks the single link between
    // headers[2] and headers[3] — confirms the chain-linking constraint is
    // actually enforced per-link, not just that a correct chain passes.
    let mut headers = real_signet_chain();
    headers[3][4] = headers[3][4] ^ 0x01;
    let _tip = verify_header_chain(real_checkpoint_hash(), headers);
}

// --- Phase 5: full main() wiring, fully synthetic --------------------
//
// Necessarily synthetic end-to-end (not real chain data): main() requires
// a deposit tx included under the REAL chain tip's REAL merkle_root, but
// no real transaction anywhere matches this brand-new template (see
// parse_deposit_tx's fixture note above) — so proving the full wiring
// composes correctly needs a self-consistent synthetic chain built
// specifically so its tip's merkle_root matches a synthetic tx. Every
// sub-piece this composes IS separately real-data-tested above: real
// header-chain linking+PoW (test_verify_header_chain_accepts_real_...),
// real Merkle-path math (test_verify_tx_inclusion_matches_real_signet_tx).
// This test's headers use an artificially easy target (bits: exponent =
// 32, mantissa = 0xffffff, the loosest value target_from_bits accepts) so
// PoW passes for arbitrary near-zero-effort headers — the PoW *check
// itself* is what the real-data tests above validate, not re-tested here.
fn synthetic_checkpoint_hash() -> [u8; 32] {
    [0; 32]
}

