mod bitcoin;

use bitcoin::{checkpoint_commitment, deposit_nullifier, parse_deposit_tx, parse_merkle_root, verify_header_chain, verify_pow, verify_tx_inclusion, K};

// Proves: (1) a chain of K validly-mined signet headers correctly links
// forward from a disclosed trusted checkpoint; (2) `tx` — a fixed-shape
// deposit transaction (see bitcoin.nr's "Phase 4" section) — is included
// under the chain tip's merkle_root; (3) `recipient`/`amount`/`nullifier`
// are exactly what that transaction's extracted (recipient, amount, txid)
// commit to. This is the full statement the backend's automatic minter
// checks before minting real WrappedBTC — see BTC_DEPOSIT_DESIGN.md.
//
// checkpoint_hash is a PRIVATE witness; checkpoint_commitment_pub is its
// Poseidon2 commitment (see bitcoin::checkpoint_commitment's own comment
// for why — a raw `pub [u8; 32]` doesn't collapse to one Solidity
// bytes32). recipient/amount are public so the minter knows who to credit
// and how much without needing its own independent copy of the Bitcoin
// data — the proof itself is what has to have seen it. No more
// blinding/note_commitment here (that was the prior private-note design —
// see git history): this circuit's only remaining job is proving the real
// Bitcoin payment happened and extracting who it's for, not shaping a
// private commitment.
fn main(
    checkpoint_commitment_pub: pub Field,
    recipient: pub Field,
    amount: pub Field,
    nullifier: pub Field,
    checkpoint_hash: [u8; 32],
    headers: [[u8; bitcoin::HEADER_SIZE]; K],
    tx: [u8; bitcoin::TX_SIZE],
    merkle_path_elements: [[u8; 32]; bitcoin::MAX_MERKLE_DEPTH],
    merkle_path_indices: [bool; bitcoin::MAX_MERKLE_DEPTH],
    merkle_actual_depth: u32,
) {
    assert(checkpoint_commitment(checkpoint_hash) == checkpoint_commitment_pub);
    let _tip_hash = verify_header_chain(checkpoint_hash, headers);

    let tip_merkle_root = parse_merkle_root(headers[K - 1]);
    let (parsed_recipient, parsed_amount, txid) = parse_deposit_tx(tx);
    verify_tx_inclusion(txid, tip_merkle_root, merkle_path_elements, merkle_path_indices, merkle_actual_depth);

    assert(parsed_recipient == recipient);
    assert(parsed_amount == amount);
    assert(deposit_nullifier(txid) == nullifier);
}

// Real signet header, height 317028, fetched from
// https://mempool.space/signet/api/block/{hash}/header on 2026-08-10.
// hash = 00000007fdf8034e3b91009d6a950ba045cb08a4bee12cc9e47050247c744e83
fn real_signet_header() -> [u8; bitcoin::HEADER_SIZE] {
    [
        0x00, 0x00, 0x00, 0x20, 0x63, 0xcc, 0xe8, 0xe0, 0xf9, 0x42, 0xde, 0x8e,
        0xa7, 0x34, 0x5c, 0x95, 0xb8, 0xda, 0x2e, 0x5d, 0xa0, 0x55, 0x42, 0xa5,
        0xc2, 0x8a, 0xee, 0xc9, 0xa1, 0x2f, 0x35, 0x7b, 0x05, 0x00, 0x00, 0x00,
        0xe3, 0x5b, 0x9c, 0x9d, 0x08, 0x61, 0xc2, 0x69, 0xbe, 0xa5, 0x4d, 0xf9,
        0xa9, 0xb9, 0x37, 0x64, 0xaf, 0x86, 0x65, 0xe4, 0xbe, 0x13, 0xf1, 0xfc,
        0xdf, 0x72, 0x2f, 0x47, 0x5e, 0x01, 0x93, 0x15, 0x7e, 0x4d, 0x79, 0x6a,
        0x9f, 0x6a, 0x14, 0x1d, 0xba, 0x7c, 0x9f, 0x04,
    ]
}

#[test]
fn test_double_sha256_matches_real_signet_header() {
    // Independently recomputed with Python's hashlib against the same
    // mempool.space response before trusting this fixture — not synthetic.
    let expected_hash: [u8; 32] = [
        0x83, 0x4e, 0x74, 0x7c, 0x24, 0x50, 0x70, 0xe4, 0xc9, 0x2c, 0xe1, 0xbe,
        0xa4, 0x08, 0xcb, 0x45, 0xa0, 0x0b, 0x95, 0x6a, 0x9d, 0x00, 0x91, 0x3b,
        0x4e, 0x03, 0xf8, 0xfd, 0x07, 0x00, 0x00, 0x00,
    ];
    assert(bitcoin::double_sha256(real_signet_header()) == expected_hash);
}

#[test]
fn test_verify_pow_accepts_real_signet_header() {
    let _hash = verify_pow(real_signet_header());
}

#[test]
fn test_parse_prev_hash_matches_real_header() {
    // previousblockhash from the same mempool.space block response, in its
    // native little-endian byte order (i.e. the reverse of the displayed
    // hex string 000000057b352fa1c9ee8ac2a54255a05d2edab8955c34a78ede42f9e0e8cc63).
    let expected_prev_hash: [u8; 32] = [
        0x63, 0xcc, 0xe8, 0xe0, 0xf9, 0x42, 0xde, 0x8e, 0xa7, 0x34, 0x5c, 0x95,
        0xb8, 0xda, 0x2e, 0x5d, 0xa0, 0x55, 0x42, 0xa5, 0xc2, 0x8a, 0xee, 0xc9,
        0xa1, 0x2f, 0x35, 0x7b, 0x05, 0x00, 0x00, 0x00,
    ];
    assert(bitcoin::parse_prev_hash(real_signet_header()) == expected_prev_hash);
}

#[test(should_fail)]
fn test_verify_pow_rejects_header_tampered_to_claim_impossible_target() {
    // Same real, validly-mined header — but with its `bits` field (offset
    // 72..76) overwritten to claim an artificially tiny target (exponent =
    // 3, mantissa = 1 => target = 1) that this header's real hash cannot
    // possibly be below. Confirms the circuit actually enforces the PoW
    // check against the header's own claimed difficulty, not just that it
    // accepts a header that happens to be valid.
    let mut header = real_signet_header();
    header[72] = 1;
    header[73] = 0;
    header[74] = 0;
    header[75] = 3;
    let _hash = verify_pow(header);
}

