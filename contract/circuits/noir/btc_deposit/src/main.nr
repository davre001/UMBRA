        0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0x02, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x22, 0x6a, 0x20, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x12, 0x34,
        0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78,
        0x90, 0x12, 0x34, 0x56, 0x78, 0x90, 0x90, 0xd0, 0x03, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x16, 0x00, 0x14, 0x1e, 0xc1, 0x50, 0x30, 0x71, 0x06, 0xf1,
        0x3a, 0x43, 0x44, 0x37, 0xf0, 0x3f, 0x10, 0xef, 0xc0, 0xc8, 0xfa, 0x45,
        0xf3, 0x00, 0x00, 0x00, 0x00,
    ]
}

fn synthetic_merkle_sibling() -> [u8; 32] {
    [0x22; 32]
}

fn synthetic_merkle_path() -> [[u8; 32]; bitcoin::MAX_MERKLE_DEPTH] {
    let mut path: [[u8; 32]; bitcoin::MAX_MERKLE_DEPTH] = [[0; 32]; bitcoin::MAX_MERKLE_DEPTH];
    path[0] = synthetic_merkle_sibling();
    path
}

fn synthetic_merkle_indices() -> [bool; bitcoin::MAX_MERKLE_DEPTH] {
    [false; bitcoin::MAX_MERKLE_DEPTH]
}

#[test]
fn test_main_accepts_fully_synthetic_end_to_end_deposit() {
    let checkpoint_hash = synthetic_checkpoint_hash();
    let commitment = checkpoint_commitment(checkpoint_hash);
    let headers = synthetic_header_chain();
    let tx = synthetic_deposit_tx_v2();

    let (recipient, amount, txid) = parse_deposit_tx(tx);
    let expected_nullifier = deposit_nullifier(txid);

    main(
        commitment,
        recipient,
        amount,
        expected_nullifier,
        checkpoint_hash,
        headers,
        tx,
        synthetic_merkle_path(),
        synthetic_merkle_indices(),
        1,
    );
}

#[test(should_fail)]
fn test_main_rejects_checkpoint_hash_not_matching_commitment() {
    // A checkpoint_hash that's internally valid (correctly-linked chain)
    // but doesn't match the publicly-committed checkpoint_commitment —
    // confirms main() actually enforces that binding, not just that a
    // correct commitment/hash pair together happens to pass.
    let checkpoint_hash = synthetic_checkpoint_hash();
    let wrong_commitment = checkpoint_commitment(checkpoint_hash) + 1;
    let headers = synthetic_header_chain();
    let tx = synthetic_deposit_tx_v2();
    let (recipient, amount, txid) = parse_deposit_tx(tx);
    let nullifier = deposit_nullifier(txid);

    main(
        wrong_commitment, recipient, amount, nullifier, checkpoint_hash, headers, tx,
        synthetic_merkle_path(), synthetic_merkle_indices(), 1,
    );
}

#[test(should_fail)]
fn test_main_rejects_recipient_not_matching_tx() {
    // The publicly-claimed recipient doesn't match what's actually encoded
    // in the tx's OP_RETURN — confirms main() recomputes and checks it
    // against the real parsed value, rather than trusting whatever the
    // caller labels it (the exact front-running gap this binding exists
    // to close — see bitcoin.nr's own comment on why the OP_RETURN is
    // load-bearing).
    let checkpoint_hash = synthetic_checkpoint_hash();
    let commitment = checkpoint_commitment(checkpoint_hash);
    let headers = synthetic_header_chain();
    let tx = synthetic_deposit_tx_v2();
    let (recipient, amount, txid) = parse_deposit_tx(tx);
    let wrong_recipient = recipient + 1;
    let nullifier = deposit_nullifier(txid);

    main(
        commitment, wrong_recipient, amount, nullifier, checkpoint_hash, headers, tx,
        synthetic_merkle_path(), synthetic_merkle_indices(), 1,
    );
}

#[test(should_fail)]
fn test_main_rejects_amount_not_matching_tx() {
    // Same idea as the recipient check above, for amount — a minter
    // trusting an unchecked public `amount` input could be told to mint
    // more WrappedBTC than the real Bitcoin payment actually carried.
    let checkpoint_hash = synthetic_checkpoint_hash();
    let commitment = checkpoint_commitment(checkpoint_hash);
    let headers = synthetic_header_chain();
    let tx = synthetic_deposit_tx_v2();
    let (recipient, amount, txid) = parse_deposit_tx(tx);
    let wrong_amount = amount + 1;
    let nullifier = deposit_nullifier(txid);

    main(
        commitment, recipient, wrong_amount, nullifier, checkpoint_hash, headers, tx,
        synthetic_merkle_path(), synthetic_merkle_indices(), 1,
    );
}

// --- Phase 4 fixtures --------------------------------------------------
//
// `verify_tx_inclusion` (the Merkle-path algorithm) is tested against a
// 100% real, naturally-occurring signet transaction and its real
// mempool.space Merkle proof — same discipline as Phases 1-3.
//
// `parse_deposit_tx` (the fixed OP_RETURN+P2WPKH deposit template) is
// necessarily tested against a hand-built, synthetic transaction instead:
// this exact 2-output shape is a brand-new convention this project is
// defining, so no real historical example of it exists on-chain to fetch.
// Its own dependency — txid computation via sha256d — IS separately
// real-data-verified (see test_double_sha256_matches_real_signet_header
// and the real-tx txid check below); only the template-shape assertions
// themselves are inherently synthetic. Disclosed here rather than left
// implicit.

// Real transaction 913c43415145e84d11b73d292eff432b4ba832913f31096f30f0a6de4721f82b
// (height 317028, position 2), fetched from mempool.space on 2026-08-10.
// Its non-witness serialization, txid, and Merkle path were independently
// reconstructed and cross-checked with Node's crypto module against the
// API's own returned values before trusting this fixture: txid matched,
// and the reconstructed root matched header 317028's real merkle_root
// field exactly (see test_verify_tx_inclusion_matches_real_signet_tx).
fn real_tx_txid() -> [u8; 32] {
    [
        0x2b, 0xf8, 0x21, 0x47, 0xde, 0xa6, 0xf0, 0x30, 0x6f, 0x09, 0x31, 0x3f,
        0x91, 0x32, 0xa8, 0x4b, 0x2b, 0x43, 0xff, 0x2e, 0x29, 0x3d, 0xb7, 0x11,
        0x4d, 0xe8, 0x45, 0x51, 0x41, 0x43, 0x3c, 0x91,
    ]
}

fn real_tx_merkle_root() -> [u8; 32] {
    // header 317028's merkle_root field (bytes 36..68), native order.
    [
        0xe3, 0x5b, 0x9c, 0x9d, 0x08, 0x61, 0xc2, 0x69, 0xbe, 0xa5, 0x4d, 0xf9,
        0xa9, 0xb9, 0x37, 0x64, 0xaf, 0x86, 0x65, 0xe4, 0xbe, 0x13, 0xf1, 0xfc,
        0xdf, 0x72, 0x2f, 0x47, 0x5e, 0x01, 0x93, 0x15,
    ]
}

// 11 real path elements (native order) + 9 zero-padding entries up to
// bitcoin::MAX_MERKLE_DEPTH (20) — the padding entries are inert: with
// actual_depth = 11, verify_tx_inclusion no-ops every level >= 11
// regardless of their content.
fn real_tx_merkle_path() -> [[u8; 32]; bitcoin::MAX_MERKLE_DEPTH] {
    [
        [0x04, 0x3b, 0xbd, 0x36, 0xa4, 0x71, 0xc3, 0x46, 0xfc, 0x6a, 0xc2, 0xce,
         0x88, 0x59, 0x60, 0x7f, 0x7e, 0xad, 0xf9, 0x5e, 0x28, 0xd3, 0x82, 0x9c,
         0x31, 0xd1, 0x11, 0x7a, 0xd8, 0x12, 0xf6, 0xe4],
        [0xed, 0xa6, 0x6e, 0xd6, 0x49, 0x42, 0x13, 0x2c, 0xbc, 0x8d, 0xd5, 0x8a,
         0x94, 0xf9, 0x05, 0xb6, 0x7e, 0x03, 0xdf, 0x85, 0x56, 0xa2, 0x62, 0x91,
         0xbc, 0x0c, 0x76, 0x2f, 0xb5, 0x28, 0x11, 0x26],
        [0x9f, 0x4c, 0x6b, 0xd7, 0x8f, 0x76, 0x6a, 0x02, 0x69, 0xab, 0xda, 0x99,
         0xe7, 0xbc, 0x1e, 0x14, 0x14, 0xd3, 0x60, 0x51, 0xff, 0x2b, 0xd0, 0x14,
         0x91, 0xec, 0x4e, 0x7d, 0x97, 0x3c, 0x6e, 0x04],
        [0x2f, 0x92, 0xf0, 0x93, 0x4f, 0xe7, 0x7a, 0xa0, 0xdc, 0xcb, 0x0c, 0x1f,
         0x3b, 0x58, 0x7e, 0xfe, 0xfc, 0xe6, 0xff, 0x9f, 0xcc, 0x57, 0xba, 0x4d,
         0x7b, 0x13, 0x74, 0x4e, 0x7f, 0x11, 0xfb, 0x48],
        [0xe4, 0x7f, 0x7f, 0x85, 0x95, 0x84, 0xe3, 0x8a, 0xec, 0x9d, 0xb8, 0x4c,
         0x9d, 0x91, 0xcc, 0x3b, 0x96, 0x37, 0xd5, 0x96, 0x7e, 0x21, 0x77, 0x4a,
         0x07, 0x00, 0xad, 0x6b, 0x38, 0xd2, 0x0d, 0x8c],
        [0x76, 0xe0, 0x94, 0x62, 0x8c, 0xa1, 0x73, 0x16, 0x05, 0x93, 0xd6, 0xf9,
         0xb9, 0x9a, 0x05, 0x63, 0xca, 0x44, 0x9d, 0xbb, 0xe2, 0xf6, 0x01, 0xfc,
         0x45, 0x13, 0x3d, 0x3b, 0xff, 0xae, 0x1c, 0x60],
        [0xf0, 0x5a, 0x04, 0xc8, 0xf3, 0xe4, 0xda, 0x53, 0x9e, 0x2a, 0x78, 0xf1,
         0xb2, 0xc6, 0xa3, 0xe6, 0x9b, 0x47, 0xe8, 0x4d, 0xe5, 0x0a, 0x9b, 0x68,
         0x4e, 0x9f, 0xfe, 0x6a, 0xe8, 0x82, 0x1f, 0xbb],
        [0x4a, 0xb8, 0x5e, 0x96, 0xe6, 0x1c, 0x72, 0xbf, 0x71, 0x9f, 0x0c, 0x0f,
         0xab, 0xc9, 0xff, 0x15, 0x32, 0xf3, 0x5c, 0x86, 0x96, 0xc0, 0xc7, 0xdb,
         0xad, 0xa0, 0x7d, 0xcb, 0x43, 0xd3, 0xdd, 0x18],
        [0xe3, 0x79, 0xc1, 0x57, 0xa1, 0x3c, 0xd5, 0x69, 0x92, 0x13, 0x83, 0xd9,
         0x7a, 0xd5, 0xb8, 0x53, 0xc1, 0xf8, 0x88, 0x86, 0x5a, 0x81, 0x44, 0x23,
         0x8d, 0x34, 0xf0, 0xa9, 0xfe, 0x03, 0x30, 0x2e],
        [0x54, 0x36, 0xff, 0x54, 0x4f, 0x5b, 0x64, 0x05, 0xfb, 0x9e, 0xa5, 0xfa,
         0x6b, 0x6d, 0x72, 0xd8, 0x8c, 0x4a, 0x2f, 0x2f, 0xa0, 0x7d, 0x12, 0x05,
         0x85, 0x53, 0x5d, 0xfb, 0x0a, 0x9d, 0xd4, 0xa1],
        [0xe1, 0x0d, 0x16, 0x42, 0x82, 0x3d, 0x4a, 0xe3, 0xbe, 0x4c, 0x16, 0x5d,
         0xcc, 0xbe, 0xb1, 0x8d, 0x73, 0xc4, 0xa6, 0x82, 0x91, 0xf3, 0x85, 0xb9,
         0x1d, 0x2e, 0x0c, 0x93, 0x3d, 0xf9, 0x33, 0x46],
        [0; 32], [0; 32], [0; 32], [0; 32], [0; 32],
        [0; 32], [0; 32], [0; 32], [0; 32],
    ]
}

fn real_tx_merkle_indices() -> [bool; bitcoin::MAX_MERKLE_DEPTH] {
    // is_right per real level, derived from mempool.space's `pos: 2` (leaf
    // index) the same way umbra_lib's own merkle_root reads path_indices:
    // pos even => current is left child; pos odd => current is right
    // child; pos >>= 1 each level. Padding levels (11..20) are inert.
    [
        false, true, false, false, false, false, false, false, false, false, false,
        false, false, false, false, false, false, false, false, false,
    ]
}

#[test]
fn test_verify_tx_inclusion_matches_real_signet_tx() {
    bitcoin::verify_tx_inclusion(
        real_tx_txid(),
        real_tx_merkle_root(),
        real_tx_merkle_path(),
        real_tx_merkle_indices(),
        11,
    );
}

#[test(should_fail)]
fn test_verify_tx_inclusion_rejects_wrong_root() {
    // Same real, valid Merkle path — but checked against a root that
    // isn't the one it actually proves inclusion under.
    let mut wrong_root = real_tx_merkle_root();
    wrong_root[0] = wrong_root[0] ^ 0x01;
    bitcoin::verify_tx_inclusion(real_tx_txid(), wrong_root, real_tx_merkle_path(), real_tx_merkle_indices(), 11);
}

// Hand-built (synthetic — see note above), internally self-consistent
// deposit transaction: 1 input (empty scriptSig, borrowed from the real tx
// above so it's at least a real prevout reference), 2 outputs — OP_RETURN
// carrying recipient = 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC (Hardhat's
// well-known test account #2, left-zero-padded to 32 bytes), then a P2WPKH
// payment of 150,000 sats to the real deployed vault (see
// bitcoin::VAULT_PUBKEY_HASH). Generated with Node's crypto module, not
// hand-typed, before trusting this fixture.
fn synthetic_deposit_tx() -> [u8; bitcoin::TX_SIZE] {
    [
        0x02, 0x00, 0x00, 0x00, 0x01, 0xdc, 0x2e, 0xc6, 0x28, 0x2f, 0x4d, 0x0b,
        0xc7, 0x95, 0xf6, 0xe2, 0xa3, 0xc8, 0x56, 0xca, 0x80, 0x52, 0x23, 0x2b,
        0x16, 0x0b, 0x28, 0x12, 0xb2, 0xb0, 0x4e, 0x78, 0xca, 0x9a, 0x23, 0xf6,
        0xf0, 0x06, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0x02, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x22, 0x6a, 0x20, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x3c, 0x44,
        0xcd, 0xdd, 0xb6, 0xa9, 0x00, 0xfa, 0x2b, 0x58, 0x5d, 0xd2, 0x99, 0xe0,
        0x3d, 0x12, 0xfa, 0x42, 0x93, 0xbc, 0xf0, 0x49, 0x02, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x16, 0x00, 0x14, 0x1e, 0xc1, 0x50, 0x30, 0x71, 0x06, 0xf1,
        0x3a, 0x43, 0x44, 0x37, 0xf0, 0x3f, 0x10, 0xef, 0xc0, 0xc8, 0xfa, 0x45,
        0xf3, 0x00, 0x00, 0x00, 0x00,
    ]
}

#[test]
fn test_parse_deposit_tx_extracts_recipient_and_amount() {
    let (recipient, amount, txid) = bitcoin::parse_deposit_tx(synthetic_deposit_tx());
    assert(recipient == 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC);
    assert(amount == 150000);
    let expected_txid: [u8; 32] = [
        0x76, 0x3a, 0xb4, 0x1e, 0x81, 0xe7, 0xee, 0xe8, 0x86, 0xfc, 0x80, 0x47,
        0x3c, 0x4b, 0xb9, 0x2c, 0xfb, 0xab, 0xfc, 0x50, 0x3a, 0xc9, 0xcc, 0x0f,
        0xca, 0x1c, 0xae, 0x2a, 0xf4, 0xa3, 0xd9, 0x21,
    ];
    assert(txid == expected_txid);
}

#[test(should_fail)]
fn test_parse_deposit_tx_rejects_non_zero_padding() {
    // Same synthetic tx, but with one of the OP_RETURN's left-padding
    // bytes (58..70) set non-zero — confirms the "address as bytes32"
    // padding is actually enforced, not silently truncated to the low 20
    // bytes regardless of what the top 12 hold.
    let mut tx = synthetic_deposit_tx();
    tx[58] = 0x01;
    let _ = bitcoin::parse_deposit_tx(tx);
}

#[test(should_fail)]
fn test_parse_deposit_tx_rejects_wrong_vault_destination() {
    // Same synthetic tx, but output 1 pays a different pubkey hash than
    // bitcoin::VAULT_PUBKEY_HASH — confirms the circuit actually checks the
    // payment went to UMBRA's own vault address, not just that *some*
    // P2WPKH output exists.
    let mut tx = synthetic_deposit_tx();
    tx[101] = tx[101] ^ 0x01;
    let _ = bitcoin::parse_deposit_tx(tx);
}

#[test(should_fail)]
fn test_parse_deposit_tx_rejects_wrong_output_count() {
    // Same synthetic tx, but claiming 1 output instead of the required 2 —
    // confirms the template shape itself is enforced, not just each
    // individual field once you're already inside the expected layout.
    let mut tx = synthetic_deposit_tx();
    tx[46] = 1;
    let _ = bitcoin::parse_deposit_tx(tx);
}
