PRIVATE_KEY=
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Optional — deploy.ts. Unset defaults to the deployer address.
ATTESTER_ADDRESS=

# Optional — real asset addresses to allowlist on the vault at deploy time.
# assetId is fixed by position: 0 = WFLR, 1 = FXRP, 2 = USDT0 (must match
# whatever the frontend/circuits use for the same assets).
# Look these up on https://coston2-explorer.flare.network — never hardcode
# FAsset/AssetManager addresses, they can change.
WFLR_ADDRESS=
FXRP_ADDRESS=
USDT0_ADDRESS=
