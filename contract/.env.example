PRIVATE_KEY=
# The official coston2-api.flare.network endpoint caps eth_getLogs at 30
# blocks per query, too small for this app's leaf-history scans.
COSTON2_RPC_URL=https://flare-testnet.drpc.org

# Optional — deploy.ts. Unset defaults to the deployer address.
ATTESTER_ADDRESS=

# Optional — real ERC20 asset addresses to allowlist on the vault at deploy
# time. assetId is fixed by position: 0 = native C2FLR (no address needed —
# shield()/withdraw() hold/pay it directly, see ShieldedVault.sol's
# nativeAssetId), 1 = FXRP, 2 = USDT0 (must match whatever the
# frontend/circuits use for the same assets).
# Look these up on https://coston2-explorer.flare.network — never hardcode
# FAsset/AssetManager addresses, they can change.
FXRP_ADDRESS=
USDT0_ADDRESS=

# 2-of-3 Safe deployment for ShieldedVault's DEFAULT_ADMIN_ROLE handoff (see
# scripts/deploy-safe.ts) — owner 1 is the deployer key above (PRIVATE_KEY).
# Owners 2 and 3 are separate keys on purpose (a laptop compromise alone
# shouldn't hand over the Safe) — never reuse PRIVATE_KEY's value for these.
SAFE_OWNER_2_ADDRESS=
SAFE_OWNER_2_PRIVATE_KEY=
SAFE_OWNER_3_ADDRESS=
SAFE_OWNER_3_PRIVATE_KEY=
